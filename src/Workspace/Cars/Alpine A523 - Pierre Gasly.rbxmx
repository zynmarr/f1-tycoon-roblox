										<Item class="Script" referent="RBX046160AC328949458CEDD307EEE67976">
											<Properties>
												<bool name="DefinesCapabilities">true</bool>
												<bool name="Disabled">false</bool>
												<Content name="LinkedSource"><null /></Content>
												<string name="Name">Script</string>
